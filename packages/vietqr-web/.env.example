# vietqr-web runtime configuration. Read at server start (not baked into the build),
# so one image serves every deployment. Invalid values stop the server with a clear error.
# Copy to .env.local for development.

# REQUIRED. Base URL of vietqr-api (server-side only; browsers reach it via /api/* proxy).
VIETQR_API_URL=http://localhost:8000

# Largest request body (bytes) the /api proxy accepts, mainly image uploads to /decode.
# Keep equal to vietqr-api's VIETQR_MAX_UPLOAD_BYTES. Default: 8388608 (8 MiB)
VIETQR_MAX_UPLOAD_BYTES=8388608

# Product name shown in header and page title. Default: VietQR
VIETQR_APP_NAME=VietQR

# Logo URL or path under public/ (e.g. /logo.svg). Default: none
VIETQR_APP_LOGO=

# Comma-separated enabled locales: vi, en. Default: vi,en
VIETQR_LOCALES=vi,en

# Must be one of VIETQR_LOCALES. Default: first of VIETQR_LOCALES
VIETQR_DEFAULT_LOCALE=vi

# Default Template: compact | print | qr_only. Default: compact
VIETQR_DEFAULT_TEMPLATE=compact

# Comma-separated enabled pages: studio, inspect, banks, pay.
# "studio" is served at the root "/"; if you leave it out, "/" returns 404 like any disabled page.
# "pay" is OFF by default (anyone can craft a Pay link for any account; see ADR 0001).
# Default: studio,inspect,banks
VIETQR_ENABLED_PAGES=studio,inspect,banks

# Footer links as "Label|URL" pairs separated by semicolons. Default: none
# Example: GitHub|https://github.com/you/vietqr;Terms|/terms
VIETQR_FOOTER_LINKS=
