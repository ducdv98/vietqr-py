# Used by docker-compose.yml (copy to .env). All optional; defaults shown.
# Host port the web app is published on.
WEB_PORT=3000
# Shared by API and web (the web proxy limit must match the API limit).
VIETQR_MAX_UPLOAD_BYTES=8388608
# Web settings; see packages/vietqr-web/.env.example for details.
VIETQR_APP_NAME=VietQR
VIETQR_LOCALES=vi,en
VIETQR_DEFAULT_LOCALE=vi
VIETQR_DEFAULT_TEMPLATE=compact
VIETQR_ENABLED_PAGES=studio,inspect,banks
